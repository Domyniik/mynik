# Segredos do servidor (Supabase Edge Functions). NUNCA vão para o git nem para as apps.
# Em produção: Supabase → Project Settings → Edge Functions → Secrets (ou `supabase secrets set`).
# Em local: copia para supabase/functions/.env.

# Loja Shopify (app do Dev Dashboard, scopes só de leitura).
SHOPIFY_SHOP_DOMAIN=<a-tua-loja>.myshopify.com  # o domínio .myshopify.com (Shopify → Definições → Domínios), não o domínio público
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Alternativa antiga: token fixo de um app personalizado (shpat_…).
SHOPIFY_ADMIN_TOKEN=

# Sync agendado da loja (pg_cron, migrations/20261122000500_store_cron.sql).
# CRON_SECRET: um valor aleatório (ex.: `openssl rand -hex 32`), igual ao do Vault `mynik_cron_secret`.
CRON_SECRET=
# Email da conta Mynik dona da loja (o sync escreve nas tabelas dela).
MYNIK_OWNER_EMAIL=
