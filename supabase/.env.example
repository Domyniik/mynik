# Segredos do servidor (Supabase Edge Functions). NUNCA vão para o git nem para as apps.
# Em produção: Supabase → Project Settings → Edge Functions → Secrets (ou `supabase secrets set`).
# Em local: copia para supabase/functions/.env.

# Loja Shopify (app do Dev Dashboard, scopes só de leitura).
SHOPIFY_SHOP_DOMAIN=neloce.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Alternativa antiga: token fixo de um app personalizado (shpat_…).
SHOPIFY_ADMIN_TOKEN=
