{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mynik",
  "version": "2.0.0",
  "identifier": "com.domynik.mynik.desktop",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../web/out",
    "beforeDevCommand": "npm --prefix ../web run dev",
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mynik",
        "width": 1360,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#0e0f11",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "category": "Productivity",
    "shortDescription": "A tua vida num só sítio",
    "longDescription": "Finanças, contas a pagar, loja Shopify, projetos, notas, carro, documentos, carreira e património — com os mesmos dados do iPhone.",
    "copyright": "© 2026 Domynik",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Portuguese"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["mynik"]
      }
    }
  }
}
